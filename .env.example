# Rules work without credentials. Keep paid AI off on an unrestricted public demo.
ENABLE_AI=false
# auto: prefer Muse when MODEL_API_KEY is set; otherwise use OpenAI.
# Set openai or muse to select one explicitly.
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Meta Model API dashboard key (independent of the OpenAI key).
MODEL_API_KEY=
MUSE_MODEL=muse-spark-1.3
